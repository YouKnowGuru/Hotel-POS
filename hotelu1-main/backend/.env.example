# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of allowed frontend origins.
# Example for Vercel:
#   CORS_ORIGIN=https://your-app.vercel.app,https://your-app-git-main.vercel.app
CORS_ORIGIN=http://localhost:3000


# ===== Database (pick ONE style) =====

# Style 1: Single connection URL (Render Postgres recommended)
#   postgres://user:password@host:5432/dbname
#   mysql://user:password@host:3306/dbname
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_DIALECT=postgres   # auto-detected from URL, override if needed
# DB_SSL=true           # required for Render Postgres / Aiven MySQL

# Style 2: Discrete vars (good for local dev)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mrbeast_db
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# ===== Email (Nodemailer / Gmail SMTP) =====
# Delivery-order emails: placed / payment approved / delivered / COD received.
# For Gmail use an App Password (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your gmail address
SMTP_PASS=your 16-character app password
MAIL_FROM=Your Brand <your gmail address>
BRAND_NAME=Your Brand
