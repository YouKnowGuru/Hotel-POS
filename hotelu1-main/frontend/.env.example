# For local dev only — uses CRA-style "REACT_APP_" prefix
# Set REACT_APP_API_URL to your deployed backend URL on Vercel:
#   REACT_APP_API_URL=https://your-backend.onrender.com

# Local LAN testing
REACT_APP_API_PORT=3001

# Production (Vercel) -> set this in Vercel project Environment Variables:
# REACT_APP_API_URL=https://hotelu1-backend.onrender.com
